VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Feature flags (default off). Restart Vite after changing.
# VITE_FEATURE_SHOPIFY=true

# Shopify (Edge Function secrets — set via `supabase secrets set`, not Vite):
# Only used when VITE_FEATURE_SHOPIFY=true
# Preferred:
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# SHOPIFY_WEBHOOK_SECRET=   # often same as client secret
# Optional legacy token:
# SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123
# App scopes: read/write_products, read/write_inventory, read_locations, read_orders, write_files
# Optional Web Push (browser closed): npx web-push generate-vapid-keys
# SHOPIFY_VAPID_PUBLIC_KEY=
# SHOPIFY_VAPID_PRIVATE_KEY=
# SHOPIFY_VAPID_SUBJECT=mailto:you@example.com
